# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL, used for Open Graph image links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar (OAuth, our own calendar account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced once by: npm run google:token
GOOGLE_REFRESH_TOKEN=
# Redirect URI registered on the OAuth client; only used to mint the token above.
GOOGLE_REDIRECT_URI=http://localhost:5353/oauth2callback
# "primary", or the calendar id from Calendar settings > Integrate calendar.
GOOGLE_CALENDAR_ID=primary

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Service role key. Server only — it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
