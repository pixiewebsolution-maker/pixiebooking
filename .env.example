# Copy to .env.local and fill in. Never commit .env.local.

# --- Google Calendar (OAuth, on your own calendar account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced once by: npm run google:token
GOOGLE_REFRESH_TOKEN=
# Redirect URI registered on the OAuth client; only used to mint the token above.
GOOGLE_REDIRECT_URI=http://localhost:5353/oauth2callback
# "primary", or the calendar id from Calendar settings > Integrate calendar.
GOOGLE_CALENDAR_ID=primary

# --- Confirmation email (sent through Gmail on the same OAuth client) ---
# Both optional. MAIL_FROM must be the signed-in account or one of its verified
# "send mail as" aliases; left blank, Gmail uses the account itself.
MAIL_FROM=
MAIL_FROM_NAME=Pixie Webs

# --- Escape hatch ---
# Set to 1 to switch the hidden anti-spam field off. Do this the moment it
# flags a real booking: a lost lead costs more than a spam one.
HONEYPOT_OFF=
